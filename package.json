{
  "name": "asturpower-training",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.js --host 0.0.0.0",
    "build": "vite build --config app/vite.config.js",
    "test": "node --test tests/*.test.mjs",
    "test:garmin": "node --test tests/garmin-*.test.mjs",
    "test:database:garmin": "node scripts/test-garmin-database.mjs",
    "simulate:garmin": "node scripts/simulate-garmin.mjs",
    "build:garmin:cloudflare": "wrangler deploy --dry-run --config wrangler.garmin.toml --outdir .wrangler/garmin-build",
    "test:garmin:cloudflare": "npm run build:garmin:cloudflare && node scripts/test-garmin-worker.mjs",
    "test:garmin:cloudflare:app": "npm run build:garmin:cloudflare:app && wrangler deploy --dry-run --config wrangler.garmin-app.toml --outdir .wrangler/garmin-app-build && node scripts/test-garmin-app-worker.mjs",
    "build:garmin:cloudflare:app": "npm run build && node scripts/prepare-garmin-app-assets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "jsdom": "26.1.0",
    "miniflare": "5.20261103.0-beta",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
